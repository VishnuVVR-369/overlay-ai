{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist/main",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/main/**/*", "src/lib/**/*"],
  "exclude": ["node_modules", "dist", "src/renderer"]
}
